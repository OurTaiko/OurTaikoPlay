    m_Metadata:
      m_Items: []
  - m_Id: 133160990
    m_Localized: System Language
    m_Metadata:
      m_Items: []
  - m_Id: 133160991
    m_Localized: The language of menus and messages, and of song titles and subtitles. Songs without a translation keep their original title.
    m_Metadata:
      m_Items: []
  - m_Id: 133160992
    m_Localized: Diagnostics
    m_Metadata:
