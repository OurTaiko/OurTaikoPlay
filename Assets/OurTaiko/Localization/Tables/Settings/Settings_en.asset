    m_Metadata:
      m_Items: []
  - m_Id: 133161064
    m_Localized: Output Backend
    m_Metadata:
      m_Items: []
  - m_Id: 133161065
    m_Localized: How the game talks to the audio device. ASIO requires a driver.
    m_Metadata:
      m_Items: []
  - m_Id: 133161066
    m_Localized: Automatic
    m_Metadata:
      m_Items: []
  - m_Id: 133161067
    m_Localized: BassWASAPI on Windows
    m_Metadata:
      m_Items: []
  - m_Id: 133161068
    m_Localized: BassSimple on this device
    m_Metadata:
      m_Items: []
  - m_Id: 133161069
    m_Localized: Windows audio, shared or exclusive
    m_Metadata:
      m_Items: []
  - m_Id: 133161070
    m_Localized: Requires an installed ASIO driver
    m_Metadata:
      m_Items: []
  - m_Id: 133161071
    m_Localized: Cross-platform output
    m_Metadata:
      m_Items: []
  - m_Id: 133161072
    m_Localized: Output Period
    m_Metadata:
      m_Items: []
  - m_Id: 133161073
    m_Localized: Shorter periods reduce delay but may crackle. Windows controls the actual period.
    m_Metadata:
      m_Items: []
  - m_Id: 133161074
    m_Localized: Shorter periods reduce delay but may crackle. The device may choose a different period.
    m_Metadata:
      m_Items: []
  - m_Id: 133161075
    m_Localized: Default ({0} ms)
    m_Metadata:
      m_Items: []
  - m_Id: 133161076
    m_Localized: Default
    m_Metadata:
      m_Items: []
  - m_Id: 133161077
    m_Localized: Device Buffer
    m_Metadata:
      m_Items: []
  - m_Id: 133161078
    m_Localized: '0: default; other values are raised to at least twice the output period. macOS and iOS ignore this request.'
    m_Metadata:
      m_Items: []
  - m_Id: 133161079
    m_Localized: '0: default; other values are raised to at least twice the output period. The system may choose a different buffer.'
    m_Metadata:
      m_Items: []
  - m_Id: 133161080
    m_Localized: Android AAudio
    m_Metadata:
      m_Items: []
  - m_Id: 133161081
    m_Localized: Use AAudio output when available.
    m_Metadata:
      m_Items: []
  - m_Id: 133161082
    m_Localized: WASAPI Exclusive
    m_Metadata:
      m_Items: []
  - m_Id: 133161083
    m_Localized: Request exclusive access to the output device. Falls back to shared mode if unavailable.
    m_Metadata:
      m_Items: []
  - m_Id: 133161084
    m_Localized: WASAPI Raw Mode
    m_Metadata:
      m_Items: []
  - m_Id: 133161085
    m_Localized: Request output without Windows audio enhancements. Falls back if unsupported.
    m_Metadata:
      m_Items: []
  - m_Id: 133161086
    m_Localized: WASAPI Async Mode
    m_Metadata:
      m_Items: []
  - m_Id: 133161087
    m_Localized: Prefill audio to reduce dropouts at the cost of extra delay. Exclusive mode only.
    m_Metadata:
      m_Items: []
  - m_Id: 133161088
    m_Localized: WASAPI Buffer
    m_Metadata:
      m_Items: []
  - m_Id: 133161089
    m_Localized: Buffer per block in exclusive mode (two blocks). Shared mode uses its own buffer.
    m_Metadata:
      m_Items: []
  - m_Id: 133161090
    m_Localized: WASAPI Period
    m_Metadata:
      m_Items: []
  - m_Id: 133161091
    m_Localized: 'Shared-mode period; 0: system default. Ignored in exclusive mode.'
    m_Metadata:
      m_Items: []
  - m_Id: 133161092
    m_Localized: System Default
    m_Metadata:
      m_Items: []
  - m_Id: 133161093
    m_Localized: ASIO Device Index
    m_Metadata:
      m_Items: []
  - m_Id: 133161094
    m_Localized: Driver index, starting at 0. Requires an installed ASIO driver.
    m_Metadata:
      m_Items: []
  - m_Id: 133161095
    m_Localized: ASIO Buffer
    m_Metadata:
      m_Items: []
  - m_Id: 133161096
    m_Localized: 'Buffer length in samples; 0: driver default. Driver-supported sizes only.'
    m_Metadata:
      m_Items: []
  - m_Id: 133161097
    m_Localized: Driver Default
    m_Metadata:
      m_Items: []
  - m_Id: 133161098
    m_Localized: samples
    m_Metadata:
      m_Items: []
  - m_Id: 133161099
    m_Localized: Sample Rate
    m_Metadata:
      m_Items: []
  - m_Id: 133161100
    m_Localized: BASS initialization rate. WASAPI output uses the device's negotiated format.
    m_Metadata:
      m_Items: []
  - m_Id: 133161101
    m_Localized: Requested sample rate. The output device may use a different rate.
    m_Metadata:
      m_Items: []
  - m_Id: 133161102
    m_Localized: BASS Stream Update Period
    m_Metadata:
      m_Items: []
  - m_Id: 133161103
    m_Localized: Stream buffering is disabled during playback; this does not control the output-device period.
    m_Metadata:
      m_Items: []
  - m_Id: 133161104
    m_Localized: BASS Stream Buffer
    m_Metadata:
      m_Items: []
  - m_Id: 133161105
    m_Localized: At least 1 ms above the stream update period. Playback streams disable this buffer.
    m_Metadata:
      m_Items: []
  - m_Id: 133161106
    m_Localized: Song Clock
    m_Metadata:
      m_Items: []
  - m_Id: 133161107
    m_Localized: What the notes follow while the music plays. Changing it shifts the picture and the judgment by the output latency, so set the offsets again.
    m_Metadata:
      m_Items: []
