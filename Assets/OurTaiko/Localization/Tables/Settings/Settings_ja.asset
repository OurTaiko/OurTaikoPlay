    m_Localized: "\u6BCE\u30D5\u30EC\u30FC\u30E0\u3001\u753B\u9762\u306E\u66F4\u65B0\u3092\u5F85\u3061\u307E\u3059\u3002\u30AA\u30F3\u306E\u9593\u306F\u30D5\u30EC\u30FC\u30E0\u30EC\u30FC\u30C8\u306E\u4EE3\u308F\u308A\u306B\u30EA\u30D5\u30EC\u30C3\u30B7\u30E5\u30EC\u30FC\u30C8\u306B\u306A\u308A\u307E\u3059\u3002"
