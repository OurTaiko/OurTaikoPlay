  - m_Id: 653254716
    m_Localized: "\u5148\u306B OurTaiko \u30A2\u30AB\u30A6\u30F3\u30C8\u3067\u30ED\u30B0\u30A4\u30F3\u3057\u3066\u304F\u3060\u3055\u3044\uFF08\u30B2\u30FC\u30E0\u8A2D\u5B9A \u203A \u30A2\u30AB\u30A6\u30F3\u30C8\uFF09\u3002"
