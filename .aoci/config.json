  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
